generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DONOR
  COORDINATOR
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum RequestUrgency {
  ROUTINE
  URGENT
  CRITICAL
}

enum OutreachStatus {
  RESPONDED // donor raised their hand from the app
  CALLED
  NO_ANSWER
  COMING
  DECLINED
  DONATED
}

enum RequestStatus {
  OPEN
  FULFILLED
  CANCELLED
  EXPIRED
}

model Account {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(DONOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  donor        Donor?
  createdRequests BloodRequest[] @relation("RequestCreator")
  verifiedRequests BloodRequest[] @relation("RequestVerifier")
  createdDrives Drive[]          @relation("DriveCreator")
}

model Donor {
  id             Int        @id @default(autoincrement())
  accountId      Int        @unique
  displayName    String
  bloodGroup     BloodGroup
  phoneEncrypted String
  area           String
  latitude       Float
  longitude      Float
  available      Boolean    @default(true)
  lastDonationAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  account        Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  donations      Donation[]
  driveRsvps     DriveRsvp[]
  outreach       Outreach[]

  @@index([bloodGroup, available])
}

model Donation {
  id        Int      @id @default(autoincrement())
  donorId   Int
  donatedAt DateTime
  requestId Int? // set when recorded by a coordinator marking the donor "donated" for a request
  createdAt DateTime @default(now())
  donor     Donor    @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([donorId, donatedAt])
  @@index([donorId, requestId])
}

model BloodRequest {
  id                Int           @id @default(autoincrement())
  bloodGroup        BloodGroup
  units             Int           @default(1)
  unitsReceived     Int           @default(0) // arranged outside outreach (blood bank, walk-in)
  hospitalName      String
  area              String
  latitude          Float
  longitude         Float
  urgency           RequestUrgency @default(URGENT)
  status            RequestStatus @default(OPEN)
  verified          Boolean       @default(false)
  expiresAt         DateTime
  createdById       Int
  verifiedById      Int?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdBy         Account       @relation("RequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedBy        Account?      @relation("RequestVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  outreach          Outreach[]

  @@index([status, expiresAt, bloodGroup])
}

// Blood donation drives / camps posted by coordinators (Rotaract clubs, colleges).
model Drive {
  id          Int         @id @default(autoincrement())
  title       String
  organizer   String
  venue       String
  area        String
  latitude    Float
  longitude   Float
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int?
  createdById Int
  createdAt   DateTime    @default(now())
  createdBy   Account     @relation("DriveCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rsvps       DriveRsvp[]

  @@index([endsAt, startsAt])
}

model DriveRsvp {
  driveId   Int
  donorId   Int
  createdAt DateTime @default(now())
  drive     Drive    @relation(fields: [driveId], references: [id], onDelete: Cascade)
  donor     Donor    @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@id([driveId, donorId])
}

// One row per (request, donor) the coordinator has worked: who was called and what they said.
model Outreach {
  requestId Int
  donorId   Int
  status    OutreachStatus
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  request   BloodRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donor     Donor          @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@id([requestId, donorId])
}
